{
  "name": "nextjs-reciclapp",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 8080",
    "deploy:frontend:production": "npm run build:production && gcloud app deploy deployment/frontend/app.yaml --ignore-file=deployment/frontend/.gcloudignore",
    "deploy:frontend:stage": "npm run build:stage && gcloud app deploy deployment/frontend/app-stage.yaml --ignore-file=deployment/frontend/.gcloudignore",
    "deploy:backend:production": "cd fast_api && gcloud app deploy ../deployment/backend/app.yaml --ignore-file=../deployment/backend/.gcloudignore",
    "deploy:backend:stage": "cd fast_api && gcloud app deploy ../deployment/backend/app-stage.yaml --ignore-file=../deployment/backend/.gcloudignore",
    "export": "next export",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" --max-warnings=0",
    "test": "jest",
    "gcp-build": "",
    "switch-env": "node scripts/switch-env.js",
    "dev:development": "npm run switch-env development && npm run dev",
    "dev:production": "npm run switch-env production && npm run dev",
    "dev:stage": "npm run switch-env stage && npm run dev",
    "build:development": "npm run switch-env development && npm run build",
    "build:production": "npm run switch-env production && npm run build",
    "build:stage": "npm run switch-env stage && npm run build"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@googlemaps/markerclusterer": "^2.0.10",
    "@googlemaps/react-wrapper": "^1.1.35",
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "^7.3.5",
    "@mui/x-charts": "^8.21.0",
    "@mui/x-data-grid": "^7.23.4",
    "@mui/x-data-grid-generator": "^7.23.4",
    "@mui/x-date-pickers": "^7.23.4",
    "@react-oauth/google": "^0.11.1",
    "@tanstack/react-query": "^5.29.2",
    "dayjs": "^1.11.19",
    "devextreme": "^21.2.5",
    "dotenv": "^16.6.1",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.2",
    "eslint-plugin-unused-imports": "^4.3.0",
    "moment": "^2.30.1",
    "next": "^15.5.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.4.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^8.57.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^16.1.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.7",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-n": "^15.2.3",
    "eslint-plugin-promise": "^6.0.0",
    "eslint-plugin-react": "^7.30.1",
    "jest": "^29.1.2",
    "jest-environment-jsdom": "^29.1.2",
    "typescript": "^5.9.3"
  }
}
