# Production Environment Configuration
NODE_ENV=production

# API URL
NEXT_PUBLIC_API_URL=https://fastapi-dot-norse-voice-343214.uc.r.appspot.com

# Firebase/Firestore
FIREBASE_PROJECT_ID=reciclapp-dev-23776
