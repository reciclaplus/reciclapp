# Development Environment Configuration
NODE_ENV=development

# API URLs
NEXT_PUBLIC_API_URL=http://localhost:8000
FAST_API_URL=http://localhost:8000

# Firebase/Firestore
FIREBASE_PROJECT_ID=reciclapp-dev-23776
FIRESTORE_DATABASE_ID=(default)

# OAuth Configuration
OAUTH_REDIRECT_URI=http://localhost:3000

# Google Cloud
GOOGLE_CLOUD_PROJECT=reciclapp-dev-23776

# CORS Origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Service Account Files (development)
FIRESTORE_SERVICE_ACCOUNT_FILE=./routers/firestore-service-account-dev.json
CLIENT_SECRET_FILE=./client_secret_dev.json