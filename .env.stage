# Stage Environment Configuration
NODE_ENV=stage

# API URL
NEXT_PUBLIC_API_URL=https://api-dev-dot-norse-voice-343214.uc.r.appspot.com

# Firebase/Firestore (uses same as production)
FIREBASE_PROJECT_ID=norse-voice-343214
FIRESTORE_DATABASE_ID=(default)

# OAuth Configuration
OAUTH_REDIRECT_URI=https://reciclapp-dev-dot-norse-voice-343214.uc.r.appspot.com

# Google Cloud
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_PRODUCTION_GOOGLE_MAPS_API_KEY_HERE

# CORS Origins
ALLOWED_ORIGINS=https://reciclapp-dev-dot-norse-voice-343214.uc.r.appspot.com,http://localhost:3000

# Service Account Files (same as production)
FIRESTORE_SERVICE_ACCOUNT_FILE=./routers/firestore-service-account.json
CLIENT_SECRET_FILE=./client_secret_.json
